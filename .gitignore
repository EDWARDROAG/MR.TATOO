.idea/
*.swp
*.swo
*~
.DS_Store
.editorconfig
*.sublime-*
.project
.classpath
.settings/
.actor
.vscode-test/

# OS generated files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.tmp
*.temp
*.cache

