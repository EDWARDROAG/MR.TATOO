# ============================================
# .gitignore
# Archivos y directorios ignorados por Git
# Proyecto: MiApp (Fullstack)
# ============================================

# ============================================
# Dependencias
# ============================================

# PHP / Composer
/vendor/
composer.phar
composer.lock
.phplint.yml
.phpunit.result.cache
.php-cs-fixer.cache
.phpcs-cache

# Node.js / NPM / Yarn
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# package-lock.json se versiona (necesario para npm ci en Docker)
yarn.lock
.pnpm-debug.log
pnpm-lock.yaml

# ============================================
# Entornos y configuraciones
# ============================================

# Environment files
.env
.env.*
!.env.example
!.env.testing
!.env.production
!.env.staging
!.env.development
!.env.pages

# IDE / Editor files
