FROM node:20-alpine AS build

WORKDIR /app
COPY package*.json ./
# imagemin/gifsicle postinstall falla en Alpine; no se usa en vite.config.js
# Preferir npm ci si hay lockfile; si no, npm install (repos sin package-lock)
RUN if [ -f package-lock.json ]; then npm ci --ignore-scripts; else npm install --ignore-scripts; fi

COPY . .
ARG BUILD_MODE=docker
RUN npm run build:${BUILD_MODE}

FROM nginx:alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
# Favicon / OG y fallback; el home usa assets hasheados de Vite en /assets/
COPY --from=build /app/public/images /usr/share/nginx/html/images
# HU-065: MkDocs debe existir en public/docs ANTES de este build
# (en el host: .\scripts\docs-build.ps1). Vite lo copia a dist/docs/.
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
